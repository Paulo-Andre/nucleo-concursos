# Copie para .env somente no ambiente local. No Render, use Environment.
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_SSL=true
# Certificado CA em PEM fornecido pelo banco; aceita novas linhas ou \n.
DATABASE_CA_CERT=
ROOT_INITIAL_PASSWORD=
JWT_SECRET=
PUBLIC_APP_URL=https://SEU-SERVICO.onrender.com
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Necessários apenas enquanto o armazenamento continuar no Forge/Manus.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
# Somente para preservar a identidade antiga na migração para login local.
OWNER_OPEN_ID=
